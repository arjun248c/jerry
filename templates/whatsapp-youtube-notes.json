{
  "name": "YouTube Video to Notes (WhatsApp)",
  "description": "Send a YouTube link via WhatsApp and automatically receive an AI-generated summary of the video.",
  "tags": ["AI", "WhatsApp", "YouTube", "Summarization"],
  "workflow": {
    "name": "YouTube Video to Notes (WhatsApp)",
    "description": "Send a YouTube link via WhatsApp and automatically receive an AI-generated summary of the video.",
    "active": false,
    "nodes": [
      {
        "id": "node_webhook_1",
        "type": "webhook",
        "name": "WhatsApp Trigger",
        "position": { "x": 100, "y": 200 },
        "parameters": {
          "path": "/whatsapp-yt",
          "method": "POST",
          "authType": "none",
          "responseMode": "immediate"
        }
      },
      {
        "id": "node_transform_1",
        "type": "transform",
        "name": "Extract URL & Sender",
        "position": { "x": 350, "y": 200 },
        "parameters": {
          "mappings": "[{\"source\":\"body.entry[0].changes[0].value.messages[0].text.body\",\"target\":\"videoId\"},{\"source\":\"body.entry[0].changes[0].value.messages[0].from\",\"target\":\"sender\"}]",
          "removeUnmapped": true
        }
      },
      {
        "id": "node_youtube_1",
        "type": "youtube",
        "name": "Fetch Transcript",
        "position": { "x": 600, "y": 200 },
        "parameters": {
          "operation": "getTranscript",
          "videoId": "{{item.videoId}}"
        }
      },
      {
        "id": "node_ai_1",
        "type": "ai",
        "name": "Summarize Video",
        "position": { "x": 850, "y": 200 },
        "parameters": {
          "provider": "openai",
          "model": "gpt-3.5-turbo",
          "apiKey": "",
          "systemPrompt": "You are a highly skilled note-taking assistant. Your job is to extract the most valuable, actionable, and important insights from a video transcript and present them in a clear, concise, and structured format.",
          "prompt": "Please summarize the following YouTube video transcript. Break it down into:\n1. 📌 A one-sentence core summary\n2. 🔑 Key takeaways (bullet points)\n3. 💡 Actionable insights\n\nTranscript: {{transcript}}",
          "outputField": "notes"
        }
      },
      {
        "id": "node_whatsapp_1",
        "type": "whatsapp",
        "name": "Send Notes",
        "position": { "x": 1100, "y": 200 },
        "parameters": {
          "to": "{{item.sender}}",
          "messageType": "text",
          "message": "🎥 *YouTube Video Summary*\n\n{{item.notes}}\n\n——\n_Generated by Jerry AI_"
        }
      }
    ],
    "connections": [
      {
        "id": "conn_1",
        "sourceNodeId": "node_webhook_1",
        "targetNodeId": "node_transform_1"
      },
      {
        "id": "conn_2",
        "sourceNodeId": "node_transform_1",
        "targetNodeId": "node_youtube_1"
      },
      {
        "id": "conn_3",
        "sourceNodeId": "node_youtube_1",
        "targetNodeId": "node_ai_1"
      },
      {
        "id": "conn_4",
        "sourceNodeId": "node_ai_1",
        "targetNodeId": "node_whatsapp_1"
      }
    ]
  }
}
